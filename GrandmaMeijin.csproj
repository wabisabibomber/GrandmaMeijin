<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.0.1</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets/app.ico')">Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Compile Remove="developer/**/*.cs" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/app.ico" LogicalName="GrandmaMeijin.AppIcon" Condition="Exists('Assets/app.ico')" />
  </ItemGroup>
</Project>
