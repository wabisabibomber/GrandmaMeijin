#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "Resource.h"
@ICON_RESOURCE@
IDD_MAIN DIALOGEX 0, 0, 280, 220
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "GrandmaMeijin"
FONT 9, "Yu Gothic UI"
BEGIN
    LTEXT "STOPPED", IDC_STATUS, 12, 10, 240, 25
    LTEXT "クリック周期（ms）", -1, 12, 45, 125, 14
    EDITTEXT IDC_PERIOD, 150, 42, 85, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_PERIOD_SPIN, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_SETBUDDYINT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 225, 42, 10, 16
    LTEXT "押下時間の割合（%）", -1, 12, 70, 130, 14
    EDITTEXT IDC_DUTY, 150, 67, 85, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_DUTY_SPIN, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_SETBUDDYINT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 225, 67, 10, 16
    LTEXT "", IDC_TIMING, 12, 92, 256, 14
    PUSHBUTTON "開始", IDC_TOGGLE, 12, 113, 82, 24, WS_TABSTOP
    LTEXT "", IDC_HOTKEY_LABEL, 12, 146, 204, 14
    PUSHBUTTON "変更…", IDC_CHANGE, 219, 142, 49, 20, WS_TABSTOP
    LTEXT "現在のマウスポインター位置で左クリックします。", -1, 12, 168, 256, 14
    LTEXT "", IDC_NOTICE, 12, 185, 256, 16
    LTEXT "", IDC_SAVE_NOTICE, 12, 202, 256, 16
END
IDD_HOTKEY DIALOGEX 0, 0, 270, 151
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ホットキーの変更"
FONT 9, "Yu Gothic UI"
BEGIN
    AUTOCHECKBOX "Ctrl", IDC_CTRL, 12, 12, 50, 14
    AUTOCHECKBOX "Alt", IDC_ALT, 70, 12, 50, 14
    AUTOCHECKBOX "Shift", IDC_SHIFT, 128, 12, 50, 14
    AUTOCHECKBOX "Win", IDC_WIN, 186, 12, 50, 14
    COMBOBOX IDC_KEY, 12, 34, 145, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_PREVIEW, 12, 60, 246, 14
    LTEXT "Fキー以外は修飾キーが必要です。\nF12はWindows予約キーです。OSや他アプリが使用中の組み合わせも登録できません。", -1, 12, 79, 246, 35
    DEFPUSHBUTTON "適用", IDOK, 12, 122, 70, 20
    PUSHBUTTON "キャンセル", IDCANCEL, 90, 122, 80, 20
END
1 VERSIONINFO
FILEVERSION 1,0,1,0
PRODUCTVERSION 1,0,1,0
FILEFLAGSMASK 0x3fL
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "041104b0"
  BEGIN
   VALUE "FileDescription", "GrandmaMeijin (C++ preview)"
   VALUE "FileVersion", "1.0.1.0"
   VALUE "ProductName", "GrandmaMeijin"
   VALUE "ProductVersion", "1.0.1-native-preview"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x411, 1200
 END
END
